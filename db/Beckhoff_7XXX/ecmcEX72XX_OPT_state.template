#- OPT-only DS402 state decoding from the existing status record.
#- State masks ignore voltage, warning and mode/manufacturer-specific bits.
#- Local links preserve input INVALID alarms; refresh at 10 Hz for display.
record(calc,"${ECMC_P}Drv${CH_ID}-DS402StateCode") {
  field(DESC,"Decoded DS402 state code")
  field(INPA,"${ECMC_P}Drv${CH_ID}-Stat NPP MS")
  field(SCAN,".1 second")
  field(PINI,"YES")
  #- B and C cache the two masks to fit CALC's 79-character string limit.
  field(CALC,"B:=A&79;C:=A&111;B=0?0:B=64?1:C=33?2:C=35?3:C=39?4:C=7?5:B=15?6:B=8?7:8")
  field(FLNK,"${ECMC_P}Drv${CH_ID}-DS402State.PROC")
}
record(mbbi,"${ECMC_P}Drv${CH_ID}-DS402State") {
  field(DESC,"Decoded DS402 drive state")
  field(INP,"${ECMC_P}Drv${CH_ID}-DS402StateCode NPP MS")
  field(ZRST,"Not ready to switch on")
  field(ONST,"Switch on disabled")
  field(TWST,"Ready to switch on")
  field(THST,"Switched on")
  field(FRST,"Operation enabled")
  field(FVST,"Quick stop active")
  field(SXST,"Fault reaction active")
  field(SVST,"Fault")
  field(EIST,"Unknown")
}
