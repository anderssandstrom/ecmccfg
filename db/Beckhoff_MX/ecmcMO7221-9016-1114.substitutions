#- EL7221-compatible drive and encoder records, using the MO-specific PDO map.
file "ecmcEL72XX_DRV.template" {
  pattern { CH_ID, ESLO, EGU }
    { 01, 2.3406E-5, "rad/s" }
}

file "ecmcEL72XX_ENC.template" {
  pattern { CH_ID }
    { 01 }
}

file "ecmcMO7221-9016.template" {
  pattern { CH_ID }
    { 01 }
}

file "ecmc_analogInput-chX.template" {
  pattern { CH_ID, sourceName, KEY, suffix, DESC, EGU, ESLO, PREC, LOPR, HOPR, LOLO, LOW, HIGH, HIHI, HYST, LLSV, LSV, HSV, HHSV }
    { 01, "velocityActual", "Drv", "-VelAct", "Actual Vel", "rad/s", 2.3406E-5, 3, 0, 0, 0, 0, 0, 0, 0, "NO_ALARM", "NO_ALARM", "NO_ALARM", "NO_ALARM" }
    { 01, "torqueActual", "Drv", "-TrqAct", "Actual Trq", "%", 0.1, 1, -100, 100, 0, -80, 80, 0, 0, "NO_ALARM", "NO_ALARM", "MINOR", "NO_ALARM" }
    { 01, "voltageActual", "Drv", "-VolAct", "Actual Voltage", "V", 0.001, 3, 0, 60, 8, 20, 49, 50, 0.25, "MAJOR", "MINOR", "MINOR", "MAJOR" }
    { 01, "temperatureActual", "Drv", "-TmpAct", "PCB Temperature", "degC", 0.1, 1, -40, 150, 0, 0, 0, 0, 0, "NO_ALARM", "NO_ALARM", "NO_ALARM", "NO_ALARM" }
}

file "ecmc_analogOutput-chX.template" {
  pattern { CH_ID, sourceName, KEY, suffix, DESC, EGU, ESLO, PREC, LOPR, HOPR, LOLO, LOW, HIGH, HIHI, HYST, LLSV, LSV, HSV, HHSV }
    { 01, "torqueOffset", "Drv", "-TrqOff", "Torque Offset", "%", 0.1, 1, -200, 200, 0, 0, 0, 0, 0, "NO_ALARM", "NO_ALARM", "NO_ALARM", "NO_ALARM" }
}

# FSOE outputs (outputs from master to slave)
file "ecmc_controlWord-chX.template" {
pattern
  { CH_ID, KEY,              sourceName        }
  { 01,    FSoE-CmdOut,      fsoe_cmd_out_     }
  { 01,    FSoE-DataOut,     fsoe_data_out_    }
  { 01,    FSoE-CrcOut,      fsoe_crc_out_     }
  { 01,    FSoE-ConnIdOut,   fsoe_conn_id_out_ }
}

# FSOE inputs (inputs to master from slave)
file "ecmc_status-chX.template" {
pattern
  { CH_ID, KEY,              sourceName             ,suffix }
  { 01,    FSoE-CmdIn,       fsoe_cmd_in_           , ""    }
  { 01,    FSoE-DataIn,      fsoe_data_in_          , ""    }
  { 01,    FSoE-CrcIn,       fsoe_crc_in_           , ""    }
  { 01,    FSoE-ConnIdIn,    fsoe_conn_id_in_       , ""    }
  { 01,    FSoE-StateIn,     fsoe_state_in_         , ""    }
  { 01,    FSoE-CycCntIn,    fsoe_cycle_counter_in_ , ""    }
}
