#- Extract one Boolean status from a packed input using asynMask.
record(bi,"${ECMC_P}${REC_NAME}") {
  field(DESC, "${DESC}")
  field(PINI, "1")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "I/O Intr")
  field(INP,  "@asynMask(${PORT},${ADDR=0},${MASK},${TIMEOUT=1})T_SMP_MS=${T_SMP_MS=1000}/TYPE=asynUInt32Digital/ec${MASTER_ID}.s${SLAVE_POS}.${SRC_NAME}?")
  field(ZNAM, "Not good")
  field(ONAM, "Good")
  field(TSE,  "${TSE=-2}")
}
