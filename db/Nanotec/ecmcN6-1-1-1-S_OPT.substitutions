#- N6 OPT records; output initialization preserves the configured gates.

file "ecmcEL72XX_DRV.template"
{
  pattern {CH_ID}
          {01   }
}

file "ecmcEL72XX_ENC.template"
{
  pattern {CH_ID}
          {01   }
}

file "ecmc_analogInput-chX.template"
{
  pattern {CH_ID, sourceName,       KEY,   suffix,    DESC,             EGU,   ESLO, PREC}
          {01,    "velocityActual", "Drv", "-VelAct", "Actual velocity", "Raw", 1,    0   }
          {01,    "torqueActual",   "Drv", "-TrqAct", "Actual torque",   "%",   0.1,  1   }
          {01,    "errorCode",      "Drv", "-ErrCode", "Drive error code", "Raw", 1,    0   }
          {01,    "positionActualInc", "Inc", "-PosAct", "Incremental position", "Raw", 1, 0}
          {01,    "positionActualSSI", "SSI", "-PosAct", "SSI position",     "Raw", 1,    0}
}

#- The generic array record currently displays the lower 16 of the N6's
#- 32 digital-input bits.
file "ecmcN6_binaryInputArray-chX.template"
{
  pattern {CH_ID}
          {01   }
}

file "ecmcN6_binaryOutputArray-chX.template"
{
  pattern {CH_ID, PINI}
          {01,    0   }
}

file "ecmcN6_outputEnable.template"
{
  pattern {CH_ID, MASK}
          {01,    0x00010000}
          {02,    0x00020000}
          {03,    0x00040000}
}
