#- Resolved hardware option for panel visibility; not a run-time switch.
record(bi,"${ECMC_P}CfgRawPosition") {
  field(PINI,"YES")
  field(INP,"${RAW_POS}")
  field(ZNAM,"Not mapped")
  field(ONAM,"Mapped")
}

record(bi,"${ECMC_P}CfgHoming") {
  field(PINI,"YES")
  field(INP,"${HOMING=0}")
  field(ZNAM,"Not mapped")
  field(ONAM,"Mapped")
}

record(bi,"${ECMC_P}CfgCapture") {
  field(PINI,"YES")
  field(INP,"${CAPTURE=0}")
  field(ZNAM,"Not mapped")
  field(ONAM,"Mapped")
}

record(bi,"${ECMC_P}CfgAnalogIn") {
  field(PINI,"YES")
  field(INP,"${ANALOG_IN=0}")
  field(ZNAM,"Not mapped")
  field(ONAM,"Mapped")
}
