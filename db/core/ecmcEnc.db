# Shared encoder control word: probe enable/arm/auto-rearm bits 0..2,
# inspection power hold bit 3. All clients use the same UInt32Digital interface.
record(bo,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-ForceOn"){
  info(asyn:READBACK,"1")
  field(DESC, "Hold this encoder power ON")
  field(DTYP, "asynUInt32Digital")
  field(OUT, "@asynMask($(PORT),$(ADDR),0x8,$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynUInt32Digital/ax$(AXIS_NO).enc.control$(ENC_NO)?")
  field(ZNAM, "Auto")
  field(ONAM, "Force ON")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-ForceOn-RB"){
  field(DESC, "Accepted encoder power hold")
  field(PINI, "1")
  field(DTYP, "asynUInt32Digital")
  field(INP, "@asynMask($(PORT),$(ADDR),0x8,$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynUInt32Digital/ax$(AXIS_NO).enc.control$(ENC_NO)?")
  field(SCAN, "I/O Intr")
  field(ZNAM, "Auto")
  field(ONAM, "Force ON")
}

# One native Int32 reader for the complete encoder status word. Derived records
# must not bind a second asyn interface to the same native parameter.
record(longin,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-Stat") {
  field(DESC, "Encoder status word")
  field(PINI, "1")
  field(DTYP, "asynInt32")
  field(INP, "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).enc.status$(ENC_NO)?")
  field(SCAN, "I/O Intr")
  field(TSE, "$(TSE=-2)")
  field(FLNK, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrStateCalc_.PROC")
}

record(calc,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrStateCalc_") {
  field(INPA, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-Stat.VAL")
  field(CALC, "(A>>8)&7")
  field(FLNK, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrState.PROC")
}

record(mbbi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrState") {
  field(DESC, "Encoder power state")
  field(PINI, "1")
  field(INP, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrStateCalc_.VAL")
  field(ZRVL, "0") field(ZRST, "Ordinary mode")
  field(ONVL, "1") field(ONST, "Off: stale position")
  field(TWVL, "2") field(TWST, "Warming up")
  field(THVL, "3") field(THST, "Ready")
  field(FRVL, "4") field(FRST, "Fault") field(FRSV, "MAJOR")
  field(FLNK, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-StatBits_.PROC")
}

record(mbbiDirect,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-StatBits_") {
  field(INP, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-Stat.VAL")
  field(FLNK, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrEnable-RB.PROC")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrEnable-RB") {
  field(DESC, "Power control enabled")
  field(INP, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-StatBits_.B0")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(FLNK, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrOn.PROC")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-PwrOn") {
  field(DESC, "Relay power commanded on")
  field(INP, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-StatBits_.B1")
  field(ZNAM, "Off")
  field(ONAM, "On")
  field(FLNK, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-Ready.PROC")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-Ready") {
  field(DESC, "Encoder feedback ready")
  field(INP, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-StatBits_.B2")
  field(ZNAM, "Not ready")
  field(ONAM, "Ready")
  field(FLNK, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-Homed.PROC")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-Homed") {
  field(DESC, "Encoder referenced")
  field(INP, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-StatBits_.B3")
  field(ZNAM, "Not homed")
  field(ONAM, "Homed")
  field(FLNK, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-Absolute.PROC")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-Absolute") {
  field(DESC, "Configured encoder type")
  field(INP, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-StatBits_.B4")
  field(ZNAM, "Incremental")
  field(ONAM, "Absolute")
}

#Asyn parameters for one encoder
record(ai,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-PosAct"){
  field(PINI, "1")
  field(DTYP, "asynFloat64")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynFloat64/ax$(AXIS_NO).actpos$(ENC_NO)?")
  field(PREC, "${PREC=3}")
  field(EGU,  "${EGU=mm}")
  field(SCAN, "I/O Intr")
  field(DESC, "${DESC=""}")
  field(TSE,  "$(TSE=-2)")
}

record(ai,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-VelAct"){
  field(PINI, "1")
  field(DTYP, "asynFloat64")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynFloat64/ax$(AXIS_NO).actvel$(ENC_NO)?")
  field(PREC, "${PREC=3}")
  field(EGU,  "${EGU=mm}/s")
  field(SCAN, "I/O Intr")
  field(DESC, "${DESC=""}")
  field(TSE,  "$(TSE=-2)")
}

record(ai,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-ErrId"){
  field(PINI, "1")
  field(DTYP, "asynInt32")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).enc.errid$(ENC_NO)?")
  field(PREC, "${PREC=0}")
  field(EGU,  "")
  field(SCAN, "I/O Intr")
  field(DESC, "${DESC=""}")
  field(TSE,  "$(TSE=-2)")
}

record(mbbi, "${P}${AXIS_NAME}-Enc0$(ENC_NO)-HmeProc") {
  field(DESC, "Homing procedure")
  field(VAL,  "${HOME_PROC=0}")
  field(PINI, "1")  
  field(SCAN, "Passive")
  field(ZRVL, 0)  field(ZRST, "Not Homable")
  field(ONVL, 1)  field(ONST, "Backward LS")
  field(TWVL, 2)  field(TWST, "Forward LS")
  field(THVL, 3)  field(THST, "HS via backward LS")
  field(FRVL, 4)  field(FRST, "HS via forward LS")
  field(FVVL, 5)  field(FVST, "HS mid via backward LS")
  field(SXVL, 6)  field(SXST, "HS mid via forward LS")
  field(SVVL, 7)  field(SVST, "HS apporach backwards")
  field(EIVL, 8)  field(EIST, "HS approach forward")
  field(NIVL, 9)  field(NIST, "HS mid apporach backwards")
  field(TEVL, 10) field(TEST, "HS mid approach forward")
  field(ELVL, 11) field(ELST, "IndexN via backward LS")
  field(TVVL, 12) field(TVST, "IndexN via via forward LS")
  field(TTVL, 13) field(TTST, "HomeSwiLeftRight")
  field(FTVL, 14) field(FTST, "Use Enc Cfgs")
  field(FFVL, 15) field(FFST, "Manual set position")
}

