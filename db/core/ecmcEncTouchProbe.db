# Optional touch-probe readbacks for one encoder.
# Loaded only when the encoder YAML contains a touchProbe section.

record(longin,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-Valid"){
  field(PINI, "1")
  field(DTYP, "asynInt32")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).enc.touchprobe.valid$(ENC_NO)?")
  field(SCAN, "I/O Intr")
  field(DESC, "Touch probe valid")
  field(TSE,  "$(TSE=-2)")
}

record(int64in,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-Seq"){
  field(PINI, "1")
  field(DTYP, "asynInt64")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt64/ax$(AXIS_NO).enc.touchprobe.sequence$(ENC_NO)?")
  field(SCAN, "I/O Intr")
  field(DESC, "Touch probe sequence")
  field(TSE,  "$(TSE=-2)")
}

record(ai,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-Pos"){
  field(PINI, "1")
  field(DTYP, "asynFloat64")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynFloat64/ax$(AXIS_NO).enc.touchprobe.position$(ENC_NO)?")
  field(PREC, "${PREC=3}")
  field(EGU,  "${EGU=mm}")
  field(SCAN, "I/O Intr")
  field(DESC, "Touch probe position")
  field(TSE,  "$(TSE=-2)")
}

record(longin,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-TimeValid"){
  field(PINI, "1")
  field(DTYP, "asynInt32")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt32/ax$(AXIS_NO).enc.touchprobe.timestampvalid$(ENC_NO)?")
  field(SCAN, "I/O Intr")
  field(DESC, "Touch probe timestamp valid")
  field(TSE,  "$(TSE=-2)")
}

record(int64in,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-TimeRaw"){
  field(PINI, "1")
  field(DTYP, "asynInt64")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt64/ax$(AXIS_NO).enc.touchprobe.timestampraw$(ENC_NO)?")
  field(SCAN, "I/O Intr")
  field(DESC, "Touch probe raw timestamp")
  field(TSE,  "$(TSE=-2)")
}

record(int64in,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-EventTimeNs"){
  field(PINI, "1")
  field(DTYP, "asynInt64")
  field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynInt64/ax$(AXIS_NO).enc.touchprobe.eventtimens$(ENC_NO)?")
  field(SCAN, "I/O Intr")
  field(DESC, "Touch probe event time")
  field(TSE,  "$(TSE=-2)")
}

# All probe command/readback bits share one encoder control-word parameter.
# bit 0: enable control writes; bit 1: arm; bit 2: automatic rearm.
# Keep every binding UInt32Digital; mixing native asyn interface types for
# the same parameter is unsupported.

record(bo,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-EnableCmd"){
  field(DESC, "Touch probe control enable")
  field(DTYP, "asynUInt32Digital")
  field(OUT, "@asynMask($(PORT),$(ADDR),0x1,$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynUInt32Digital/ax$(AXIS_NO).enc.control$(ENC_NO)?")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  info(asyn:READBACK,"1")
  field(SCAN, "Passive")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-Enable-RB"){
  field(DESC, "Touch probe control enable")
  field(DTYP, "asynUInt32Digital")
  field(INP, "@asynMask($(PORT),$(ADDR),0x1,$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynUInt32Digital/ax$(AXIS_NO).enc.control$(ENC_NO)?")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(PINI, "1")
  field(SCAN, "I/O Intr")
  field(TSE, "$(TSE=-2)")
}

record(bo,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-ArmCmd"){
  field(DESC, "Touch probe arm")
  field(DTYP, "asynUInt32Digital")
  field(OUT, "@asynMask($(PORT),$(ADDR),0x2,$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynUInt32Digital/ax$(AXIS_NO).enc.control$(ENC_NO)?")
  field(ZNAM, "Disarm")
  field(ONAM, "Arm")
  info(asyn:READBACK,"1")
  field(SCAN, "Passive")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-Armed"){
  field(DESC, "Touch probe arm")
  field(DTYP, "asynUInt32Digital")
  field(INP, "@asynMask($(PORT),$(ADDR),0x2,$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynUInt32Digital/ax$(AXIS_NO).enc.control$(ENC_NO)?")
  field(ZNAM, "Disarm")
  field(ONAM, "Arm")
  field(PINI, "1")
  field(SCAN, "I/O Intr")
  field(TSE, "$(TSE=-2)")
}

record(bo,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-AutoRearmCmd"){
  field(DESC, "Touch probe automatic rearm")
  field(DTYP, "asynUInt32Digital")
  field(OUT, "@asynMask($(PORT),$(ADDR),0x4,$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynUInt32Digital/ax$(AXIS_NO).enc.control$(ENC_NO)?")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  info(asyn:READBACK,"1")
  field(SCAN, "Passive")
}

record(bi,"${P}${AXIS_NAME}-Enc0$(ENC_NO)-TP-AutoRearm-RB"){
  field(DESC, "Touch probe automatic rearm")
  field(DTYP, "asynUInt32Digital")
  field(INP, "@asynMask($(PORT),$(ADDR),0x4,$(TIMEOUT))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=asynUInt32Digital/ax$(AXIS_NO).enc.control$(ENC_NO)?")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(PINI, "1")
  field(SCAN, "I/O Intr")
  field(TSE, "$(TSE=-2)")
}
