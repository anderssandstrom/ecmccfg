# Actual upload result, independent of the desired -Val record.
record(ai,"$(ECMC_P)SDO-$(NAME)-Val-RB") {
  field(DESC,"SDO actual uploaded value")
  field(DTYP,"$(INTERFACE=asynInt32)")
  field(INP,"@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))T_SMP_MS=$(T_SMP_MS=1000)/TYPE=$(INTERFACE=asynInt32)/ec$(MASTER_ID).s$(SLAVE_POS).sdo.$(NAME).readvalue?")
  field(PINI,"YES")
  field(SCAN,"I/O Intr")
  field(PREC,"$(PREC=6)")
  field(TSE,"$(TSE=-2)")
}
