#- Generic records for one directly mapped FSoE master connection.
file "ecmc_controlWord-chX.template" {
  pattern { CH_ID, KEY,            sourceName        }
          { $(CH_ID), FSoE-CmdOut,  fsoe_cmd_out_     }
          { $(CH_ID), FSoE-DataOut, fsoe_data_out_    }
          { $(CH_ID), FSoE-CrcOut,  fsoe_crc_out_     }
          { $(CH_ID), FSoE-ConnIdOut, fsoe_conn_id_out_ }
}

file "ecmc_status-chX.template" {
  pattern { CH_ID, KEY,           sourceName       , suffix }
          { $(CH_ID), FSoE-CmdIn,  fsoe_cmd_in_     , "" }
          { $(CH_ID), FSoE-DataIn, fsoe_data_in_    , "" }
          { $(CH_ID), FSoE-CrcIn,  fsoe_crc_in_     , "" }
          { $(CH_ID), FSoE-ConnIdIn, fsoe_conn_id_in_ , "" }
}
