# Motion sequence records.
# Macros:
#   P       Record prefix, for example IOC:
#   R       Sequence record prefix, for example Seq0-
#   PORT    Dedicated sequence asyn port, for example ECMC_SEQ0
#   SCAN    Poll rate for status/readback records
#   PREC    Floating-point precision
#   SOFT_TRG_FLNK Optional forward link from the soft-trigger counter

record(longout, "$(P)$(R)Edit-Index") {
  info(asyn:READBACK,"1")
  field(DESC, "Sequence edit step index")
  field(DTYP, "asynInt32")
  field(OUT,  "@asyn($(PORT),0,1000)edit.index")
}

