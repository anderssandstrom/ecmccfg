##############################################################################
## Example config for ep7211-0034

require ecmccfg v11.1.0_RC1 "EC_RATE=1000,ENG_MODE=1,MASTER_ID=1,ECMC_VER=v11.1.0_RC1"
require ecmccomp sandst_a
${SCRIPTEXEC} ${ecmccfg_DIR}addSlave.cmd, "SLAVE_ID=0, HW_DESC=EP7211-0034_OPT, OPT='TP=1,MODE=CSV'"
${SCRIPTEXEC} ${ecmccfg_DIR}applyComponent.cmd "COMP=Motor-Beckhoff-AM8121-XFX0"
epicsEnvSet("ECMC_EC_SLAVE_NUM_DRIVE",        "0")


epicsEnvSet("DEV",      "$(IOC)")
#$(SCRIPTEXEC) $(ecmccfg_DIR)loadYamlAxis.cmd "FILE=./cfg/el7201_1.yaml,DRV_ID=$(ECMC_EC_SLAVE_NUM_DRIVE),AX_NAME='Axis1',AX_ID=1"

dbgrep *s000*


