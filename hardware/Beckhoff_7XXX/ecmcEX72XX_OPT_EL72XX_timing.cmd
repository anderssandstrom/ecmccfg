#- Internal EL/EP timing policy. Resolver STD uses half-cycle Sync 0 shift.
ecmcEpicsEnvSetCalc(ECMC_EX72XX_OPT_DEFAULT_SHIFT,"${HALF_SHIFT}*500000000/${ECMC_EC_SAMPLE_RATE=1000}")
${SCRIPTEXEC} ${ecmccfg_DIR}ecmcEX72XX_DC.cmd "ASSIGN_ACTIVATE=0x700,SYNC_0_SHIFT=${SYNC_0_SHIFT=${ECMC_EX72XX_OPT_DEFAULT_SHIFT}}"
ecmcConfigOrDie "Cfg.EcAddSdo(${ECMC_EC_SLAVE_NUM},0x8011,0x11,100,4)"
epicsEnvUnset(ECMC_EX72XX_OPT_DEFAULT_SHIFT)
