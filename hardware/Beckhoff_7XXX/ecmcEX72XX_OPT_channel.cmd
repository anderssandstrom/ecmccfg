#- Internal per-channel configuration with resolved MODE, TP, INFO2, DIAG and optional ENC_STAT.
${SCRIPTEXEC} ${ecmccfg_DIR}ecmcEX72XX_OPT_validate.cmd
${ECMC_EX72XX_OPT_EL}${SCRIPTEXEC} ${ecmccfg_DIR}ecmcEX72XX_OPT_EL72XX_pdo.cmd
${ECMC_EX72XX_OPT_ELM}${SCRIPTEXEC} ${ecmccfg_DIR}ecmcEX72XX_OPT_ELM72XX_pdo.cmd

#- Select the mode explicitly by startup SDO on every configured channel.
${ECMC_EX72XX_OPT_CSV}ecmcConfigOrDie "Cfg.EcAddSdo(${ECMC_EC_SLAVE_NUM},${DRV_OUT},0x03,9,1)"
${ECMC_EX72XX_OPT_CSP}ecmcConfigOrDie "Cfg.EcAddSdo(${ECMC_EC_SLAVE_NUM},${DRV_OUT},0x03,8,1)"
${ECMC_EX72XX_OPT_CST}ecmcConfigOrDie "Cfg.EcAddSdo(${ECMC_EC_SLAVE_NUM},${DRV_OUT},0x03,10,1)"
${ECMC_EX72XX_OPT_CSTCA}ecmcConfigOrDie "Cfg.EcAddSdo(${ECMC_EC_SLAVE_NUM},${DRV_OUT},0x03,11,1)"
ecmcConfigOrDie "Cfg.EcSetSlaveNeedSDOSettings(${ECMC_EC_SLAVE_NUM},${CH_NUM},1)"
${ECMC_EX72XX_OPT_DIAG}ecmcConfigOrDie "Cfg.EcWriteSdo(${ECMC_EC_SLAVE_NUM},${DRV_CFG},0x39,2,1)"
${ECMC_EX72XX_OPT_INFO2_INPUTS}ecmcConfigOrDie "Cfg.EcWriteSdo(${ECMC_EC_SLAVE_NUM},${DRV_CFG},0x3A,10,1)"
${ECMC_EX72XX_OPT_INFO2_TEMP}ecmcConfigOrDie "Cfg.EcWriteSdo(${ECMC_EC_SLAVE_NUM},${DRV_CFG},0x3A,4,1)"
${ECMC_EX72XX_OPT_INFO2_ERRORS}ecmcConfigOrDie "Cfg.EcWriteSdo(${ECMC_EC_SLAVE_NUM},${DRV_CFG},0x3A,5,1)"

#- Load one channel at a time; records use the same logical entry names in each family.
${ECMC_EX72XX_OPT_CSV}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_csv.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_CSP}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_csp.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_TORQUE}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_cst.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_CSTCA}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_cstca.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_DIAG}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_common.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_OFFSET}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_torqueOffset.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_FOLLOWING}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_followingError.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_ENCODER_STATUS}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_encoderStatus.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_TP}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_touchProbe.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_INFO2_INPUTS}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_info2Inputs.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_INFO2_TEMP}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_info2Temp.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_INFO2_ERRORS}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_info2Errors.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"
${ECMC_EX72XX_OPT_FEEDBACK}${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_encoder.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID},OPT_VEL_ESLO=${VEL_ESLO=${DEFAULT_VEL_ESLO}},OPT_VEL_EGU=${VEL_EGU=${DEFAULT_VEL_EGU}},OPT_POS_ESLO=${POS_ESLO=${DEFAULT_POS_ESLO}},OPT_POS_EGU=${POS_EGU=${DEFAULT_POS_EGU}}'"

#- Derive human-readable state from the existing status PDO; no extra PDOs.
${SCRIPTEXEC} ${ecmccfg_DIR}applySubstitutions.cmd "SUBST_FILE=ecmcEX72XX_OPT_state.substitutions,ECMC_P=${ECMC_P},MACROS='OPT_CH_ID=${CH_ID}'"

#- Publish resolved startup choices for panel visibility.
${ECMC_EX72XX_OPT_CSV}epicsEnvSet(ECMC_EX72XX_CFG_MODE,0)
${ECMC_EX72XX_OPT_CSP}epicsEnvSet(ECMC_EX72XX_CFG_MODE,1)
${ECMC_EX72XX_OPT_CST}epicsEnvSet(ECMC_EX72XX_CFG_MODE,2)
${ECMC_EX72XX_OPT_CSTCA}epicsEnvSet(ECMC_EX72XX_CFG_MODE,3)
${ECMC_EX72XX_OPT_INFO2_INPUTS}epicsEnvSet(ECMC_EX72XX_CFG_INFO2,0)
${ECMC_EX72XX_OPT_INFO2_TEMP}epicsEnvSet(ECMC_EX72XX_CFG_INFO2,1)
${ECMC_EX72XX_OPT_INFO2_ERRORS}epicsEnvSet(ECMC_EX72XX_CFG_INFO2,2)
${ECMC_EX72XX_OPT_INFO2_NONE}epicsEnvSet(ECMC_EX72XX_CFG_INFO2,3)
ecmcEpicsEnvSetCalc(ECMC_EX72XX_CFG_OFFSET,"'${PDO_FAMILY}'='EL72XX' and '${MODE}'!='CST' and '${MODE}'!='CSTCA'","%d")
ecmcEpicsEnvSetCalc(ECMC_EX72XX_CFG_FOLLOWING,"'${MODE}'='CSP' and ('${PDO_FAMILY}'='EL72XX' or ${DIAG}==1)","%d")
ecmcEpicsEnvSetCalc(ECMC_EX72XX_CFG_ENCODER_STATUS,"${ECMC_EX72XX_OPT_ENC_VALUE}==1 and '${MODE}'!='CSTCA'","%d")
ecmcEpicsEnvSetCalc(ECMC_EX72XX_CFG_TP,"${TP}==1 and '${MODE}'!='CSTCA'","%d")
ecmcEpicsEnvSetCalc(ECMC_EX72XX_CFG_DIAG,"${DIAG}==1 and '${MODE}'!='CSTCA'","%d")
${SCRIPTEXEC} ${ecmccfg_DIR}applyTemplate.cmd "TEMPLATE_FILE=ecmcEX72XX_OPT_config.template,ECMC_P=${ECMC_P},PARAM='CFG_SUFFIX=${CFG_SUFFIX},CFG_MODE=${ECMC_EX72XX_CFG_MODE},CFG_TP=${ECMC_EX72XX_CFG_TP},CFG_INFO2=${ECMC_EX72XX_CFG_INFO2},CFG_DIAG=${ECMC_EX72XX_CFG_DIAG},CFG_OFFSET=${ECMC_EX72XX_CFG_OFFSET},CFG_FOLLOWING=${ECMC_EX72XX_CFG_FOLLOWING},CFG_ENCODER_STATUS=${ECMC_EX72XX_CFG_ENCODER_STATUS}'"
epicsEnvUnset(ECMC_EX72XX_CFG_MODE)
epicsEnvUnset(ECMC_EX72XX_CFG_INFO2)
epicsEnvUnset(ECMC_EX72XX_CFG_OFFSET)
epicsEnvUnset(ECMC_EX72XX_CFG_FOLLOWING)
epicsEnvUnset(ECMC_EX72XX_CFG_ENCODER_STATUS)
epicsEnvUnset(ECMC_EX72XX_CFG_TP)
epicsEnvUnset(ECMC_EX72XX_CFG_DIAG)
