#- Internal OPT feature validation; called with resolved MODE, TP, INFO2, DIAG and optional ENC_STAT.
#- No hardware or database operations: validate every channel before reset.
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_BAD_MODE,"'${MODE}'!='CSV' and '${MODE}'!='CSP' and '${MODE}'!='CST' and ('${MODE}'!='CSTCA' or '${PDO_FAMILY}'!='EL7411' or ${CAP_CSTCA=0}!=1)","","#-")
${ECMC_EX72XX_OPT_BAD_MODE}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: BAD_MODE (MODE=${MODE},TP=${TP},INFO2=${INFO2},DIAG=${DIAG})
epicsEnvUnset(ECMC_EX72XX_OPT_BAD_MODE)
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_BAD_TP,"${TP}!=0 and ${TP}!=1","","#-")
${ECMC_EX72XX_OPT_BAD_TP}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: BAD_TP (MODE=${MODE},TP=${TP},INFO2=${INFO2},DIAG=${DIAG})
epicsEnvUnset(ECMC_EX72XX_OPT_BAD_TP)
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_BAD_DIAG,"${DIAG}!=0 and ${DIAG}!=1","","#-")
${ECMC_EX72XX_OPT_BAD_DIAG}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: BAD_DIAG (MODE=${MODE},TP=${TP},INFO2=${INFO2},DIAG=${DIAG})
epicsEnvUnset(ECMC_EX72XX_OPT_BAD_DIAG)
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_UNSUPPORTED_TP,"${TP}==1 and ${CAP_TP}==0","","#-")
${ECMC_EX72XX_OPT_UNSUPPORTED_TP}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: UNSUPPORTED_TP (MODE=${MODE},TP=${TP},INFO2=${INFO2},DIAG=${DIAG})
epicsEnvUnset(ECMC_EX72XX_OPT_UNSUPPORTED_TP)
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_BAD_INFO2,"'${INFO2}'!='INPUTS' and '${INFO2}'!='TEMP' and '${INFO2}'!='ERRORS' and '${INFO2}'!='NONE'","","#-")
${ECMC_EX72XX_OPT_BAD_INFO2}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: BAD_INFO2 (MODE=${MODE},TP=${TP},INFO2=${INFO2},DIAG=${DIAG})
epicsEnvUnset(ECMC_EX72XX_OPT_BAD_INFO2)
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_UNSUPPORTED_INPUTS,"'${INFO2}'='INPUTS' and ${CAP_STO}==0","","#-")
${ECMC_EX72XX_OPT_UNSUPPORTED_INPUTS}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: UNSUPPORTED_INPUTS (MODE=${MODE},TP=${TP},INFO2=${INFO2},DIAG=${DIAG})
epicsEnvUnset(ECMC_EX72XX_OPT_UNSUPPORTED_INPUTS)
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_UNSUPPORTED_ERRORS,"'${INFO2}'='ERRORS' and '${PDO_FAMILY}'!='EL72XX'","","#-")
${ECMC_EX72XX_OPT_UNSUPPORTED_ERRORS}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: UNSUPPORTED_ERRORS (MODE=${MODE},TP=${TP},INFO2=${INFO2},DIAG=${DIAG})
epicsEnvUnset(ECMC_EX72XX_OPT_UNSUPPORTED_ERRORS)
#- Enable feedback status by default on supported devices, in every mode.
ecmcEpicsEnvSetCalc(ECMC_EX72XX_OPT_ENC_DEFAULT,"${CAP_ENCODER_STATUS}==1","%d")
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_ENC_VALUE,"'${ENC_STAT=}'=''","${ECMC_EX72XX_OPT_ENC_DEFAULT}","${ENC_STAT=}")
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_BAD_ENC_STAT,"${ECMC_EX72XX_OPT_ENC_VALUE}!=0 and ${ECMC_EX72XX_OPT_ENC_VALUE}!=1","","#-")
${ECMC_EX72XX_OPT_BAD_ENC_STAT}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: ENC_STAT must be 0 or 1
epicsEnvUnset(ECMC_EX72XX_OPT_BAD_ENC_STAT)
ecmcEpicsEnvSetCalcTernary(ECMC_EX72XX_OPT_UNSUPPORTED_ENC_STAT,"${ECMC_EX72XX_OPT_ENC_VALUE}==1 and ${CAP_ENCODER_STATUS}==0","","#-")
${ECMC_EX72XX_OPT_UNSUPPORTED_ENC_STAT}ecmcExit Error: ${ECMC_EC_HWTYPE} channel ${CH_ID}: ENC_STAT=1 is not supported
epicsEnvUnset(ECMC_EX72XX_OPT_UNSUPPORTED_ENC_STAT)

