#- EL7041 default drive links and scaling; axis YAML settings run later.
{% set hw = hardware.drive.data %}
ecmcConfigOrDie "Cfg.SetAxisDrvScaleDenom(${ECMC_AXIS_NO},{{ hw.denominator }})"
ecmcConfigOrDie "Cfg.LinkEcEntryToObject({{ hw.control }}.0,ax${ECMC_AXIS_NO}.drv.control)"
ecmcConfigOrDie "Cfg.LinkEcEntryToObject({{ hw.status }}.1,ax${ECMC_AXIS_NO}.drv.status)"
{% if axis.mode == "CSV" %}
ecmcConfigOrDie "Cfg.LinkEcEntryToObject({{ hw.setpoint }},ax${ECMC_AXIS_NO}.drv.velocity)"
{% else %}
ecmcConfigOrDie "Cfg.LinkEcEntryToObject({{ hw.setpoint }},ax${ECMC_AXIS_NO}.drv.position)"
{% endif %}
