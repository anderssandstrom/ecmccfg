                    ecmcEpicsEnvSetCalc("ECMC_TMP_TIME_CYCLES", "max(1,ceil({{ plc.filter.trajectory.timeMs }}*${ECMC_EC_SAMPLE_RATE}/1000))", "%d")
                    ecmcConfigOrDie "Cfg.SetAxisPLCTrajVelFilterSize(${ECMC_AXIS_NO},${ECMC_TMP_TIME_CYCLES})"
                    epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
                {%- endif %}
            {%- else %}
            {%- if (plc.filter is defined) and (plc.filter.trajectory is defined) and (plc.filter.trajectory.size is defined) %}
                ecmcLogBufferWrite("WARNING","Axis ${ECMC_AXIS_NO}: plc.filter.trajectory.size uses cycles; prefer plc.filter.trajectory.timeMs in milliseconds (legacy syntax remains supported).")
