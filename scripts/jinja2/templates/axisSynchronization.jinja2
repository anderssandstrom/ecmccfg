    {%- if (plc.filter is defined) and (plc.filter.position is defined) %}
        # WARNING: Please use updated yaml syntax for trajectory velo filtering:  plc.velocity_filter.trajectory.x)
        ecmcLogBufferWrite("WARNING","Please use updated yaml syntax for trajectory velo filtering: plc.velocity_filter.trajectory.x")
        {%- if (plc.filter is defined) and (plc.filter.position is defined) and (plc.filter.position.timeMs is defined) %}
