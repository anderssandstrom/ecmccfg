
#- =================================================================================
#- SYNCHRONIZATION
#- =================================================================================
#- Commands
ecmcConfigOrDie "Cfg.SetAxisPLCEnable(${ECMC_AXIS_NO},{{ plc.enable|default(0)|int }})"
ecmcConfigOrDie "Cfg.SetAxisAllowCommandsFromPLC(${ECMC_AXIS_NO},{{ plc.externalCommands|default(0)|int }})"

#- PLC code
{%- if plc.code is defined %}
    {%- for line in plc.code %}
        ecmcConfigOrDie "Cfg.AppendAxisPLCExpr(${ECMC_AXIS_NO})={{ line|replace(";", "|") }}"
    {%- endfor %}
{%- endif %}


{# ${SCRIPTEXEC} ${ecmccfg_DIR}loadAxisPLCFile.cmd "AX_ID=${ECMC_AXIS_NO}, FILE=${OUTPUT_FILE}, PLC_MACROS='{{plc.macros|default('')}}'" #}

#- Cleanup
#- system "rm -f ${OUTPUT_FILE}"

#- PLC Encoder velocity filter
{%- if (plc.velocity_filter is defined) and (plc.velocity_filter.encoder is defined) %}
    {%- if (plc.velocity_filter is defined) and (plc.velocity_filter.encoder is defined) and (plc.velocity_filter.encoder.timeMs is defined) %}
        {%- if (plc.velocity_filter is defined) and (plc.velocity_filter.encoder is defined) and (plc.velocity_filter.encoder.size is defined) %}
            ecmcLogBufferWrite("ERROR","Axis ${ECMC_AXIS_NO}: Specify only one of plc.velocity_filter.encoder.size and plc.velocity_filter.encoder.timeMs.")
            ecmcExit
        {%- else %}
            epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
            ecmcEpicsEnvSetCalc("ECMC_TMP_TIME_CYCLES", "max(1,ceil({{ plc.velocity_filter.encoder.timeMs }}*${ECMC_EC_SAMPLE_RATE}/1000))", "%d")
            ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterSize(${ECMC_AXIS_NO},${ECMC_TMP_TIME_CYCLES})"
            epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
        {%- endif %}
    {%- else %}
    {%- if (plc.velocity_filter is defined) and (plc.velocity_filter.encoder is defined) and (plc.velocity_filter.encoder.size is defined) %}
        ecmcLogBufferWrite("WARNING","Axis ${ECMC_AXIS_NO}: plc.velocity_filter.encoder.size uses cycles; prefer plc.velocity_filter.encoder.timeMs in milliseconds (legacy syntax remains supported).")
        ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterSize(${ECMC_AXIS_NO},{{ plc.velocity_filter.encoder.size|default(1)|int }})"
    {%- else %}
        ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterSize(${ECMC_AXIS_NO},1)"
    {%- endif %}
    {%- endif %}
    ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterEnable(${ECMC_AXIS_NO},{{ plc.velocity_filter.encoder.enable|default(0)|int }})"
{%- else %}
    {%- if (plc.filter is defined) and (plc.filter.velocity is defined) %}
        # WARNING: Please use updated yaml syntax for encoder velo filtering: plc.velocity_filter.encoder.x
        ecmcLogBufferWrite("WARNING","Please use updated yaml syntax for encoder velo filtering: plc.velocity_filter.encoder.x")
        {%- if (plc.filter is defined) and (plc.filter.velocity is defined) and (plc.filter.velocity.timeMs is defined) %}
            {%- if (plc.filter is defined) and (plc.filter.velocity is defined) and (plc.filter.velocity.size is defined) %}
                ecmcLogBufferWrite("ERROR","Axis ${ECMC_AXIS_NO}: Specify only one of plc.filter.velocity.size and plc.filter.velocity.timeMs.")
                ecmcExit
            {%- else %}
                epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
                ecmcEpicsEnvSetCalc("ECMC_TMP_TIME_CYCLES", "max(1,ceil({{ plc.filter.velocity.timeMs }}*${ECMC_EC_SAMPLE_RATE}/1000))", "%d")
                ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterSize(${ECMC_AXIS_NO},${ECMC_TMP_TIME_CYCLES})"
                epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
            {%- endif %}
        {%- else %}
        {%- if (plc.filter is defined) and (plc.filter.velocity is defined) and (plc.filter.velocity.size is defined) %}
            ecmcLogBufferWrite("WARNING","Axis ${ECMC_AXIS_NO}: plc.filter.velocity.size uses cycles; prefer plc.filter.velocity.timeMs in milliseconds (legacy syntax remains supported).")
            ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterSize(${ECMC_AXIS_NO},{{ plc.filter.velocity.size }})"
        {%- else %}
            ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterSize(${ECMC_AXIS_NO},1)"
        {%- endif %}
        {%- endif %}
        ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterEnable(${ECMC_AXIS_NO},{{ plc.filter.velocity.enable|default(0)|int }})"
    {%- else %}
        ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterSize(${ECMC_AXIS_NO}, 1)"
        ecmcConfigOrDie "Cfg.SetAxisPLCEncVelFilterEnable(${ECMC_AXIS_NO}, 0)"
    {%- endif %}
{%- endif %}

ecmcConfigOrDie "Cfg.SetAxisEncSourceType(${ECMC_AXIS_NO},{{ encoder.source|default(0)|int }})"

#- Move to different syntax because of old bad naming
#- PLC Encoder velocity velocity filter
