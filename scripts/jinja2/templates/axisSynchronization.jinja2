            ecmcLogBufferWrite("WARNING","Axis ${ECMC_AXIS_NO}: plc.filter.position.size uses cycles; prefer plc.filter.position.timeMs in milliseconds (legacy syntax remains supported).")
            ecmcConfigOrDie "Cfg.SetAxisPLCTrajVelFilterSize(${ECMC_AXIS_NO},{{ plc.filter.position.size }})"
        {%- else %}
            ecmcConfigOrDie "Cfg.SetAxisPLCTrajVelFilterSize(${ECMC_AXIS_NO},1)"
        {%- endif %}
        {%- endif %}
        ecmcConfigOrDie "Cfg.SetAxisPLCTrajVelFilterEnable(${ECMC_AXIS_NO},{{ plc.filter.position.enable|default(0)|int }})"
    {%- else %}
        {%- if (plc.filter is defined) and (plc.filter.trajectory is defined) %}
            # WARNING: Please use updated yaml syntax for trajectory velo filtering:  plc.velocity_filter.trajectory.x)
            ecmcLogBufferWrite("WARNING","Please use updated yaml syntax for trajectory velo filtering: plc.velocity_filter.trajectory.x")
            {%- if (plc.filter is defined) and (plc.filter.trajectory is defined) and (plc.filter.trajectory.timeMs is defined) %}
                {%- if (plc.filter is defined) and (plc.filter.trajectory is defined) and (plc.filter.trajectory.size is defined) %}
                    ecmcLogBufferWrite("ERROR","Axis ${ECMC_AXIS_NO}: Specify only one of plc.filter.trajectory.size and plc.filter.trajectory.timeMs.")
