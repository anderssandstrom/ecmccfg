                ecmcEpicsEnvSetCalc("ECMC_TMP_TIME_CYCLES", "max(1,ceil({{ plc.filter.position.timeMs }}*${ECMC_EC_SAMPLE_RATE}/1000))", "%d")
                ecmcConfigOrDie "Cfg.SetAxisPLCTrajVelFilterSize(${ECMC_AXIS_NO},${ECMC_TMP_TIME_CYCLES})"
