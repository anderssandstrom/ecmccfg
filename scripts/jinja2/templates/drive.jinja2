#- =============================================================================
#- Drive
#- =============================================================================
{#- links #}
{%- if (epics is defined) and (epics.name is defined) %}
    {%- set epicsName = epics.name %}
{%- else %}
    {%- set epicsName = "axis" %}
{%- endif %}

{%- if drive.type == 0 %}
    {#- For steppers, bits must be defined for control-enable and status-enabled #}
    {%- if drive.enable is defined %}
       ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.control }}.{{ drive.enable|int }}","ax${ECMC_AXIS_NO}.drv.control")"
    {%- else %}
        # WARNING: enable bit not defined. Using Beckhoff default bit, 0, for enable in control word
        ecmcLogBufferWrite("WARNING","Drive enable bit not defined. Using Beckhoff default bit, 0, for enable in control word.")
        ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.control }}.0","ax${ECMC_AXIS_NO}.drv.control")"
    {%- endif %}
    {%- if drive.enabled is defined %}
       ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.status }}.{{ drive.enabled|int }}","ax${ECMC_AXIS_NO}.drv.status")"
    {%- else %}
        # WARNING: status bit not defined. Using Beckhoff default bit, 1, for enabled in status word
        ecmcLogBufferWrite("WARNING","Drive status bit not defined. Using Beckhoff default bit, 1, for enabled in status word.")
        ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.status }}.1","ax${ECMC_AXIS_NO}.drv.status")"
    {%- endif %}
{%- else %}
    {#- DS402 #}
    {%- if drive.enable is defined %}
        # WARNING: enable control bit defined but not used in DS402 mode.
        ecmcLogBufferWrite("WARNING","Drive enable control bit defined but not used in DS402 mode.")
    {%- endif %}
    {%- if drive.enabled is defined %}
        # WARNING: enabled status bit defined but not used in DS402 mode.
        ecmcLogBufferWrite("WARNING","Drive enabled status bit defined but not used in DS402 mode.")
    {%- endif %}
    ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.control }}","ax${ECMC_AXIS_NO}.drv.control")"
    ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.status }}","ax${ECMC_AXIS_NO}.drv.status")"
{%- endif %}

{#- Todo: add more types, add default type #}
{%- if axis.mode == "CSV" %}
    ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.setpoint }}","ax${ECMC_AXIS_NO}.drv.velocity")"
    epicsEnvSet(ECMC_AX_DRV_MODE, ${ECMC_AX_DRV_MODE="CSV"})
{%- else %}
    ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.setpoint }}","ax${ECMC_AXIS_NO}.drv.position")"
    epicsEnvSet(ECMC_AX_DRV_MODE, ${ECMC_AX_DRV_MODE="CSP"})
{%- endif %}
ecmcFileExist("${ECMC_CONFIG_ROOT}addEcSlaveAxisName.cmd",1)
${SCRIPTEXEC} "${ECMC_CONFIG_ROOT}addEcSlaveAxisName.cmd" "EC_PATH={{ drive.setpoint }},ROLE=Drv,AX_NAME={{ epicsName }}"
{%- if drive.reduceTorqueEnable is defined %}
    {%- if drive.reduceTorque is defined %}
        ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.control }}.{{ drive.reduceTorque }}","ax${ECMC_AXIS_NO}.drv.reducetorque")"
        ecmcConfigOrDie "Cfg.SetAxisDrvReduceTorqueEnable(${ECMC_AXIS_NO}, {{ drive.reduceTorqueEnable|int }})"
    {%- endif %}
{%- endif %}
{%- if drive.reset is defined %}
    ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.control }}.{{ drive.reset }}","ax${ECMC_AXIS_NO}.drv.reset")"
{%- endif %}
{%- if drive.warning is defined %}
    ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.status }}.{{ drive.warning }}","ax${ECMC_AXIS_NO}.drv.warning")"
{%- endif %}
{%- if drive.error is defined %}
    {%- for bit in drive.error %}
        {%- if bit is string %}
            ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ bit }}","ax${ECMC_AXIS_NO}.drv.alarm{{loop.index0}}")"
        {%- else  %}
            ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.status }}.{{ bit }}","ax${ECMC_AXIS_NO}.drv.alarm{{loop.index0}}")"
        {%- endif  %}
    {%- endfor %}
{%- endif %}
{#- scaling #}
ecmcConfigOrDie "Cfg.SetAxisDrvScaleNum(${ECMC_AXIS_NO},{{ drive.numerator }})"
ecmcConfigOrDie "Cfg.SetAxisDrvScaleDenom(${ECMC_AXIS_NO},{{ drive.denominator }})"
{#- position-dependent CSV output compensation #}
{%- if drive.lookuptable is defined %}
    ecmcConfigOrDie "Cfg.LoadAxisDrvLookupTable(${ECMC_AXIS_NO},{{ drive.lookuptable.filename }})"
    {%- if drive.lookuptable.range is defined %}
        ecmcConfigOrDie "Cfg.SetAxisDrvLookupTableRange(${ECMC_AXIS_NO},{{ drive.lookuptable.range }})"
    {%- endif %}
    {%- if drive.lookuptable.scale is defined %}
        ecmcConfigOrDie "Cfg.SetAxisDrvLookupTableScale(${ECMC_AXIS_NO},{{ drive.lookuptable.scale }})"
    {%- endif %}
    {%- if drive.lookuptable.enable is defined %}
        ecmcConfigOrDie "Cfg.SetAxisDrvLookupTableEnable(${ECMC_AXIS_NO},{{ drive.lookuptable.enable|int }})"
    {%- endif %}
{%- endif %}
{#- brake #}
{%- if drive.brake is defined %}
    ecmcConfigOrDie "Cfg.LinkEcEntryToObject("{{ drive.brake.output }}","ax${ECMC_AXIS_NO}.drv.brake")"
    ecmcConfigOrDie "Cfg.SetAxisDrvBrakeEnable(${ECMC_AXIS_NO}, {{ drive.brake.enable|int }})"
    {%- if (drive.brake is defined) and (drive.brake.openDelayMs is defined) %}
        {%- if (drive.brake is defined) and (drive.brake.openDelay is defined) %}
            ecmcLogBufferWrite("ERROR","Axis ${ECMC_AXIS_NO}: Specify only one of drive.brake.openDelay and drive.brake.openDelayMs.")
            ecmcExit
        {%- else %}
            epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
            ecmcEpicsEnvSetCalc("ECMC_TMP_TIME_CYCLES", "ceil({{ drive.brake.openDelayMs }}*${ECMC_EC_SAMPLE_RATE}/1000)", "%d")
            ecmcConfigOrDie "Cfg.SetAxisDrvBrakeOpenDelayTime(${ECMC_AXIS_NO},${ECMC_TMP_TIME_CYCLES})"
            epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
        {%- endif %}
    {%- else %}
    {%- if (drive.brake is defined) and (drive.brake.openDelay is defined) %}
        ecmcLogBufferWrite("WARNING","Axis ${ECMC_AXIS_NO}: drive.brake.openDelay uses cycles; prefer drive.brake.openDelayMs in milliseconds (legacy syntax remains supported).")
        ecmcConfigOrDie "Cfg.SetAxisDrvBrakeOpenDelayTime(${ECMC_AXIS_NO},{{ drive.brake.openDelay }})"
    {%- else %}
        ecmcConfigOrDie "Cfg.SetAxisDrvBrakeOpenDelayTime(${ECMC_AXIS_NO},0)"
    {%- endif %}
    {%- endif %}
    {%- if (drive.brake is defined) and (drive.brake.closeAheadMs is defined) %}
        {%- if (drive.brake is defined) and (drive.brake.closeAhead is defined) %}
            ecmcLogBufferWrite("ERROR","Axis ${ECMC_AXIS_NO}: Specify only one of drive.brake.closeAhead and drive.brake.closeAheadMs.")
            ecmcExit
        {%- else %}
            epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
            ecmcEpicsEnvSetCalc("ECMC_TMP_TIME_CYCLES", "ceil({{ drive.brake.closeAheadMs }}*${ECMC_EC_SAMPLE_RATE}/1000)", "%d")
            ecmcConfigOrDie "Cfg.SetAxisDrvBrakeCloseAheadTime(${ECMC_AXIS_NO},${ECMC_TMP_TIME_CYCLES})"
            epicsEnvUnset(ECMC_TMP_TIME_CYCLES)
        {%- endif %}
    {%- else %}
    {%- if (drive.brake is defined) and (drive.brake.closeAhead is defined) %}
        ecmcLogBufferWrite("WARNING","Axis ${ECMC_AXIS_NO}: drive.brake.closeAhead uses cycles; prefer drive.brake.closeAheadMs in milliseconds (legacy syntax remains supported).")
        ecmcConfigOrDie "Cfg.SetAxisDrvBrakeCloseAheadTime(${ECMC_AXIS_NO},{{ drive.brake.closeAhead }})"
    {%- else %}
        ecmcConfigOrDie "Cfg.SetAxisDrvBrakeCloseAheadTime(${ECMC_AXIS_NO},0)"
    {%- endif %}
    {%- endif %}
{%- endif %}
