#- Optional hardware-specific ECMC commands.
#- Included only after Cfg.CreateAxis() and before ordinary axis settings.
#- PDO paths and remaining settings are handled once by the normal templates.
{%- if hardware is defined %}
  {%- for part in ['encoder', 'drive'] %}
    {%- if hardware[part] is defined and hardware[part].snippet %}
      {% include "hardwareProfiles/" ~ hardware[part].model ~ "/" ~ part ~ ".jinja2" %}
    {%- endif %}
  {%- endfor %}
{%- endif %}
