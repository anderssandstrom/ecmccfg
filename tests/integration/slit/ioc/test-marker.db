# Identifies this isolated acceptance-test setup. Not an operator command.
record(longin,"$(P)SIM:SlitTest:Schema") {
  field(DESC,"Slit acceptance-test schema")
  field(INP,"3")
  field(VAL,"3")
}

# Homing tests require the position-based home-cam link and encoder defaults.
record(longin,"$(P)SIM:SlitTest:HomingSchema") {
  field(DESC,"Slit homing fixture capability")
  field(INP,"2")
  field(VAL,"2")
}
