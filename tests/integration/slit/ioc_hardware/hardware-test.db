# Identifies this real-hardware slit fixture for the hardware acceptance runner.
record(longin,"$(P)HardwareSlitTest:Schema") {
  field(DESC,"Hardware slit test fixture schema")
  field(INP,"1")
  field(VAL,"1")
}

# Updated HI limit-homing configuration and motor home parameter records.
record(longin,"$(P)HardwareSlitTest:HomingSchema") {
  field(VAL,"1")
}
